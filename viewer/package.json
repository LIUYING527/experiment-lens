{
  "name": "experiment-lens-viewer",
  "version": "0.1.0",
  "description": "Local-first desktop viewer for agent workflows and experiments",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check event-store.js && node --check renderer.js && node --check security.js && node --check analytics.js && node --check request-body.js",
    "test": "node --test event-store.test.js security.test.js analytics.test.js request-body.test.js",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "io.experimentlens.desktop",
    "productName": "Experiment Lens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "analytics.js",
      "event-store.js",
      "security.js",
      "request-body.js",
      "package.json",
      "node_modules/ws/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Experiment-Lens-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
